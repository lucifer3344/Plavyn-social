 {
  "id": "r6-cover-blocks",
  "mark": "SITE TIP · RCC",
  "duration": 18.5,
  "endAt": 15.6,
  "headline": "Cover blocks:<br><span class=\"t\">5 checks before the pour.</span>",
  "end": "Check it.<br><span class=\"t\">Then call for concrete.</span>",
  "cards": [
   {
    "at": 1.4,
    "title": "Cover matches the drawing",
    "body": "Slab, beam and column covers are often different. Read the note, not your memory."
   },
   {
    "at": 4.2,
    "title": "Proper blocks only",
    "body": "Concrete or PVC cover blocks. No brick bats, no stone pieces."
   },
   {
    "at": 7.0,
    "title": "Tied, not just placed",
    "body": "Loose blocks shift when the crew walks the steel."
   },
   {
    "at": 9.8,
    "title": "Check edges and laps",
    "body": "That's where cover goes missing first."
   },
   {
    "at": 12.6,
    "title": "Walk it with a tape",
    "body": "Measure a few spots before you sign the pour card."
   }
  ]
 },

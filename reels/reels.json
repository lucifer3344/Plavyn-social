 {
  "id": "r10-curing",
  "mark": "SITE TIP · CONCRETE",
  "duration": 18.5,
  "endAt": 15.6,
  "headline": "Curing concrete:<br><span class=\"t\">how many days?</span>",
  "end": "Cure it right.<br><span class=\"t\">Record it daily.</span>",
  "cards": [
   {
    "at": 1.4,
    "title": "7 days minimum with OPC",
    "body": "Keep exposed surfaces continuously moist (IS 456)."
   },
   {
    "at": 4.2,
    "title": "10 days with PPC or blended cement",
    "body": "Mineral admixtures gain strength slower. Cure longer."
   },
   {
    "at": 7.0,
    "title": "Hot, dry weather? Go longer.",
    "body": "IS 456 asks for at least 10 days with OPC in hot or dry weather."
   },
   {
    "at": 9.8,
    "title": "Keep it wet, not damp",
    "body": "Ponding, wet hessian or a curing compound, as your spec says."
   },
   {
    "at": 12.6,
    "title": "Write it down",
    "body": "Start date and method in the site diary, so nobody argues later."
   }
  ]
 }
]